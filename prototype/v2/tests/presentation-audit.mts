import {chromium} from 'playwright-core';import {browserExecutable} from './browser-executable';import {mkdir,writeFile} from 'node:fs/promises';import {fileURLToPath} from 'node:url';
const browser=await chromium.launch({executablePath:browserExecutable(),headless:true});const results=[];const out=new URL('../evidence/world-rebuild/before/',import.meta.url);await mkdir(out,{recursive:true});
try{for(const [width,height] of [[1440,900],[390,844]]){const context=await browser.newContext({viewport:{width,height},deviceScaleFactor:2}),page=await context.newPage();await page.goto('http://127.0.0.1:3022/prototype');await page.locator('#petros-observations').waitFor({state:'attached'});await page.getByRole('button',{name:'Explore World ↗',exact:true}).click();await page.getByRole('button',{name:'Visit Rocket Launch Bay',exact:true}).click();await page.waitForFunction(()=>document.querySelector('canvas')?.dataset.travelling==='false');await page.screenshot({path:fileURLToPath(new URL(`world-${width}-dpr2.png`,out)),fullPage:true});results.push(await page.evaluate(()=>{const c=document.querySelector('canvas')!,r=c.getBoundingClientRect(),g=c.getContext('webgl2');return {viewport:[innerWidth,innerHeight],devicePixelRatio,canvasCss:[r.width,r.height],drawingBuffer:[c.width,c.height],effectiveDPR:c.width/r.width,contextAttributes:g?.getContextAttributes(),assets:performance.getEntriesByType('resource').filter((r:any)=>r.name.includes('/atelier/')).map((r:any)=>({file:r.name.split('/atelier/')[1],decodedBytes:r.decodedBodySize}))};}));await context.close();}await writeFile(new URL('../audit-measurements.json',out),JSON.stringify(results,null,2));console.log(JSON.stringify(results.map(({assets,...r})=>({...r,initialAssetBytes:assets.reduce((s:any,r:any)=>s+r.decodedBytes,0)})),null,2));}finally{await browser.close();}
