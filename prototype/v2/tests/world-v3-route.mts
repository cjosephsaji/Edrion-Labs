import {chromium} from 'playwright-core';import {browserExecutable} from './browser-executable';import {writeFile} from 'node:fs/promises';import assert from 'node:assert/strict';
const browser=await chromium.launch({executablePath:browserExecutable(),headless:true});try{const page=await browser.newPage({viewport:{width:1440,height:900},deviceScaleFactor:2});await page.goto('http://127.0.0.1:3025/prototype');await page.waitForURL('http://127.0.0.1:3022/prototype');await page.getByRole('button',{name:'Explore the islands',exact:true}).waitFor();await page.waitForFunction(()=>document.querySelector('canvas')?.dataset.character==='rigged-glb');assert.equal(await page.locator('canvas').count(),1);const canvas=await page.locator('canvas').evaluate(c=>({css:[c.clientWidth,c.clientHeight],backing:[c.width,c.height]}));assert.deepEqual(canvas.backing,[2880,1800]);await writeFile(new URL('../evidence/world-rebuild/route-results.json',import.meta.url),JSON.stringify({passed:true,entry:'Edrion student-web /prototype, temporary isolated verification server on 3025',destination:page.url(),canvas,integration:'Local development forwards to the isolated world. Production may opt in with PETROS_V2_ORIGIN; target retains its own access gate.'},null,2));}finally{await browser.close();}
