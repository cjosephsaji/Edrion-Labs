{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "core/**/*.ts",
    "renderers/**/*.tsx",
    "server/**/*.ts",
    "simulations/**/*.ts",
    "tests/**/*.test.ts"
  ],
  "exclude": ["node_modules", "**/._*", ".next", ".next-dev"]
}
