{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "core/**/*.ts",
    "renderers/**/*.tsx",
    "server/**/*.ts",
    "simulations/**/*.ts",
    "tests/**/*.test.ts",
    "stage/**/*.ts",
    "stage/**/*.tsx",
    "world-v3/**/*.ts",
    "world-v3/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/._*",
    ".next",
    ".next-dev"
  ]
}
