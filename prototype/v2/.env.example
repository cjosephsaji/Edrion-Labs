# Server only. Never add NEXT_PUBLIC_ to credentials.
OPENAI_API_KEY=
PETROS_V2_TEACHER_MODEL=gpt-5.4-mini
PETROS_V2_VOICE_MODEL=gpt-realtime
# A strong preview passphrase, at least 32 characters; production requires signed access.
PETROS_V2_ACCESS_SECRET=
# Shared hourly request budgets are mandatory in production (fail closed without these).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Development only; server must bind 127.0.0.1.
PETROS_V2_LOCAL_ONLY=1
