{
  "name": "@edrion/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed-platform": "./src/seed-platform.ts",
    "./dev-constants": "./src/dev-constants.ts",
    "./app-schemas": "./src/app-schemas.ts"
  },
  "scripts": {
    "generate": "find migrations -name '._*' -delete 2>/dev/null; drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed:portal": "tsx src/seed-portal.ts",
    "seed:parent": "tsx src/seed-parent.ts",
    "seed:uis": "tsx src/seed-uis.ts",
    "seed:uis-student-portal": "tsx src/seed-uis-student-portal.ts",
    "seed:proper-staff": "tsx src/seed-proper-staff.ts",
    "backfill:geo": "tsx src/backfill-geo.ts",
    "backfill:library-fsrs": "tsx src/library-fsrs-backfill.ts",
    "cleanup:logins": "tsx src/cleanup-logins.ts",
    "clear:data": "tsx src/clear-users.ts",
    "seed:student-features": "tsx src/seed-student-portal-features.ts",
    "reset:demo": "tsx src/clear-users.ts && tsx src/seed-student-portal-features.ts && tsx src/seed-uis.ts && tsx src/seed-uis-student-portal.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@edrion/feature-flags": "workspace:*",
    "@edrion/permissions": "workspace:*",
    "@edrion/schemas": "workspace:*",
    "@edrion/shared-types": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@edrion/eslint-config": "workspace:*",
    "@edrion/tsconfig": "workspace:*",
    "@types/node": "^20.16.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
