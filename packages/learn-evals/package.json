{
  "name": "@edrion/learn-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "learn-evals": "./src/cli.ts"
  },
  "scripts": {
    "run": "tsx src/cli.ts run",
    "run:core": "tsx src/cli.ts run --suite core",
    "run:full": "tsx src/cli.ts run --suite full",
    "check-fixtures": "tsx -e \"import { assertTopicCoverage } from './src/fixtures/topics.ts'; assertTopicCoverage(); console.log('ok')\""
  },
  "dependencies": {
    "@edrion/schemas": "workspace:*"
  },
  "devDependencies": {
    "@edrion/tsconfig": "workspace:*",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
