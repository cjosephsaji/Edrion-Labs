{
  "name": "edrion",
  "private": true,
  "version": "0.1.0",
  "description": "Edrion Super Admin Platform — internal control plane",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @edrion/database generate",
    "db:migrate": "pnpm --filter @edrion/database migrate",
    "db:seed": "pnpm --filter @edrion/dev-scripts exec tsx dev/seed-only.ts",
    "db:reset": "pnpm --filter @edrion/dev-scripts exec tsx dev/reset-db.ts",
    "db:studio": "pnpm --filter @edrion/database studio",
    "learn-evals": "pnpm --filter @edrion/learn-evals run",
    "learn-evals:core": "pnpm --filter @edrion/learn-evals run:core",
    "learn-evals:full": "pnpm --filter @edrion/learn-evals run:full",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:apple": "find . -name '._*' -not -path '*/node_modules/*' -delete",
    "learn-evals": "pnpm --filter @edrion/learn-evals run"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
