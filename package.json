{
  "name": "edrion",
  "private": true,
  "version": "0.1.0",
  "description": "Edrion Super Admin Platform — internal control plane",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @edrion/database generate",
    "db:migrate": "pnpm --filter @edrion/database migrate",
    "db:seed": "pnpm --filter @edrion/database seed",
    "db:studio": "pnpm --filter @edrion/database studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:apple": "find . -name '._*' -not -path '*/node_modules/*' -delete"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["msgpackr-extract"]
  }
}
