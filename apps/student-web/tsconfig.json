{
  "extends": "@edrion/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-petros-verification-dev/types/**/*.ts",
    ".next-petros-verification/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/._*"
  ]
}
