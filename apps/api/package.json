{
  "name": "@edrion/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start": "node -r tsconfig-paths/register -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@edrion/audit": "workspace:*",
    "@edrion/auth": "workspace:*",
    "@edrion/config": "workspace:*",
    "@edrion/copilot": "workspace:*",
    "@edrion/database": "workspace:*",
    "@edrion/feature-flags": "workspace:*",
    "@edrion/observability": "workspace:*",
    "@edrion/permissions": "workspace:*",
    "@edrion/schemas": "workspace:*",
    "@edrion/shared-types": "workspace:*",
    "@napi-rs/canvas": "0.1.100",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^8.0.1",
    "@node-saml/node-saml": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.22.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mathjs": "14.8.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^9.0.1",
    "openai": "^6.45.0",
    "otplib": "^13.4.1",
    "pdfjs-dist": "4.10.38",
    "playwright-core": "^1.61.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.23"
  },
  "devDependencies": {
    "@edrion/eslint-config": "workspace:*",
    "@edrion/tsconfig": "workspace:*",
    "@edrion/vitest-config": "workspace:*",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
