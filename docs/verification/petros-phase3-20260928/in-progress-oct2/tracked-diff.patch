+b4750c62-c421-4859-8d14-8af646158e9c	826cdabc-2682-4e3a-9e36-851e12d1d74d	dc099dcb-289c-476b-99ed-d29d486b7c7b	0cd6f10d-fa83-4df4-a3b4-5d9d202aace5	34219dbc-8e93-4686-bff3-e91eea540773	continue	completed	{"id": "826cdabc-2682-4e3a-9e36-851e12d1d74d", "topic": "MODULE 3", "blocks": [{"id": "79b82935-c5fa-442d-a92f-fa53a206e1ff", "status": "current", "content": {"type": "layered_explanation", "title": "Module 3: Construction Hazards & Fall Protection", "keyIdea": "Construction safety standards require active fall protection before work starts on any elevated surface, hazard zone, or opening where a fall of 4 to 6 feet or more can occur.", "firstLayer": "Module 3 outlines the major physical hazards found on construction sites, focusing heavily on falls as the leading cause of fatalities. Even short falls of 4 to 6 feet can lead to lost work time or fatal injuries. To keep workers safe, regulations require protective systems—such as guardrails, safety nets, and personal fall arrest systems (PFAS)—to be fully installed and inspected before work begins.", "deeperLayers": [{"id": "layer-2", "label": "Specific Conditions Requiring Protection", "content": "Fall protection is mandatory wherever workers face elevated exposure. This includes open sides and edges, walkways and ramps, floor and roof holes, concrete forms, rebar, excavations, wall openings, and residential construction tasks like bricklaying. Because hazards exist across multiple areas, systems must be tailored to the exact working surface."}, {"id": "layer-3", "label": "Equipment Mechanics: Guardrails and PFAS", "content": "Safety gear relies on strict engineering thresholds. For guardrails, top rails must sit between 39 and 45 inches high, and toeboards must rise at least 3 inches. For personal fall arrest systems (PFAS), workers must be properly trained, lines must support at least 5,000 pounds, equipment must be inspected before every use, and the setup must prevent any free fall greater than 6 feet."}], "sch