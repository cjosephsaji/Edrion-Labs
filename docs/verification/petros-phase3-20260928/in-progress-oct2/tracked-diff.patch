+07ff9da2-a112-452f-b0bd-46f09153d1f8	19d2e44b-38b0-49c8-a90a-4517957960b1	dc099dcb-289c-476b-99ed-d29d486b7c7b	0cd6f10d-fa83-4df4-a3b4-5d9d202aace5	1	{"body": "When working in construction and tunnelling contexts, safety procedures such as proper ladder use are essential to prevent slips, falls, and injuries. According to the course materials, improper ladder use accounts for 20% of fatal and lost workday injuries in general industry, making equipment inspection and correct setup critical first steps. Safe tunnelling and general construction practices rely on careful preparation, rigorous equipment inspection, and adherence to established setup guidelines to prevent workplace falls.", "kind": "note", "tags": ["TUNNELLING"], "title": "Tunnelling & Ladder Safety Basics"}	[{"kind": "session_block", "label": "Petros session: TUNNELLING", "blockId": "5a6f04be-74fc-45c1-a8c6-716d4f10f3f4", "excerpt": null, "pageIndex": null, "sessionId": "c7bde594-de31-43c9-aa2b-b230b4e83672", "assessmentId": null, "knowledgeItemId": null, "institutionRestricted": false}, {"kind": "document_page", "label": "Construction Safety, Tunnelling & Ergonomics — Module 3 · selected pages", "blockId": "5a6f04be-74fc-45c1-a8c6-716d4f10f3f4", "excerpt": null, "pageIndex": 50, "sessionId": "c7bde594-de31-43c9-aa2b-b230b4e83672", "assessmentId": null, "knowledgeItemId": "3d013096-89b2-42cb-b638-88e6f3c75362", "institutionRestricted": false}]	explicit_block_save	2026-09-02 11:18:31.774289+03
+b753ebc5-bd84-4f23-b263-83e3c6191776	f98997e7-b3c1-48dc-a8fc-abb89bbe5201	dc099dcb-289c-476b-99ed-d29d486b7c7b	0cd6f10d-fa83-4df4-a3b4-5d9d202aace5	1	{"body": "At a core level, agent learning is about adaptability. Instead of hardcoding every possible rule, designers build systems that observe their environment and update their internal logic to handle new tasks. Pages 1–3 of your material focus on why this capability is necessary rather than optional. Agents learn from examples because real-world environments are too unpredictable, dynamic, and complex for humans to manually write rules for every scenario.", "kind": "note", "tags": ["Pages 1–3"], "title": "Deeper Look: Why Agents Learn from Examples"}	[{"kind": "session_block", "label": "Petros session: Pages 1–3", "blockId": "6d0df3e8-b8b1-4d70-b740-a02233405742", "excerpt": null, "pageIndex": null, "sessionId": "b4e5b076-1003-4075-aadb-20d11c2dce35", "assessmentId": null, "knowledgeItemId": null, "institutionRestricted": false}, {"kind": "document_page", "label": "Machine Learning — Module 5: Learning from Examples · selected pages", "blockId": "6d0df3e8-b8b1-4d70-b740-a02233405742", "excerpt": null, "pageIndex": 0, "sessionId": "b4e5b076-1003-4075-aadb-20d11c2dce35", "assessmentId": null, "knowledgeItemId": "136cd389-8be9-4f12-937f-8bcbc5acf96a", "institutionRestricted": false}]	explicit_block_save	2026-09-02 11:32:17.141432+03
