:\\"Carbon dioxide (CO2)\\",\\"description\\":\\"Taken from air through leaf stomata; carbon source for glucose.\\"},{\\"id\\":\\"h2o\\",\\"label\\":\\"Water (H2O)\\",\\"description\\":\\"Taken up by roots; supplies electrons/H to reactions and O atoms.\\"},{\\"id\\":\\"chloroplast\\",\\"label\\":\\"Chloroplast (site)\\",\\"description\\":\\"Cell organelle where light reactions and the Calvin cycle occur.\\"},{\\"id\\":\\"light_reactions\\",\\"label\\":\\"Light reactions\\",\\"description\\":\\"Use light to make ATP and NADPH and split water (release O2).\\"},{\\"id\\":\\"calvin_cycle\\",\\"label\\":\\"Calvin cycle (carbon fixation)\\",\\"description\\":\\"Uses ATP and NADPH to assemble CO2 and H into glucose.\\"},{\\"id\\":\\"glucose\\",\\"label\\":\\"Glucose (C6H12O6)\\",\\"description\\":\\"Organic product used for energy and growth.\\"},{\\"id\\":\\"oxygen\\",\\"label\\":\\"Oxygen (O2)\\",\\"description\\":\\"Byproduct released when water is split.\\"},{\\"id\\":\\"photosynthesis_process\\",\\"label\\":\\"Photosynthesis (overall)\\",\\"description\\":\\"Process that converts light + CO2 + H2O into glucose and O2.\\"}],\\"edges\\":[{\\"from\\":\\"light\\",\\"to\\":\\"light_reactions\\",\\"label\\":\\"drives\\"},{\\"from\\":\\"h2o\\",\\"to\\":\\"light_reactions\\",\\"label\\":\\"split in\\"},{\\"from\\":\\"light_reactions\\",\\"to\\":\\"oxygen\\",\\"label\\":\\"produces\\"},{\\"from\\":\\"light_reactions\\",\\"to\\":\\"calvin_cycle\\",\\"label\\":\\"provides ATP/NADPH for\\"},{\\"from\\":\\"co2\\",\\"to\\":\\"calvin_cycle\\",\\"label\\":\\"carbon source for\\"},{\\"from\\":\\"calvin_cycle\\",\\"to\\":\\"glucose\\",\\"label\\":\\"assembles into\\"},{\\"from\\":\\"chloroplast\\",\\"to\\":\\"light_reactions\\",\\"label\\":\\"contains\\"},{\\"from\\":\\"chloroplast\\",\\"to\\":\\"calvin_cycle\\",\\"label\\":\\"contains\\"},{\\"from\\":\\"photosynthesis_process\\",\\"to\\":\\"light_reactions\\",\\"label\\":\\"includes\\"},{\\"from\\":\\"photosynthesis_process\\",\\"to\