# ─────────────────────────────────────────────────────────────────────────────
# Edrion Super Admin Platform — environment template.
# Copy to .env and fill in. NEVER commit a real .env. The service-role key and any
# secret below must exist only in the API environment, never in the web app.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (Supabase Postgres or any Postgres 15+) ──────────────────────────
# App connection uses a LEAST-PRIVILEGE role (no UPDATE/DELETE on audit/security tables).
DATABASE_URL=postgresql://postgres:SUF0ihKT8oxq0m6H@db.sloodtogibvohvbzyxyr.supabase.co:5432/postgres
# Migration connection may use a higher-privilege role.
DATABASE_MIGRATION_URL=postgres://postgres:password@localhost:5432/edrion

# ── Redis (cache, queues, rate limiting, short-lived state) ───────────────────
REDIS_URL=redis://localhost:6379
# Master switch for all Redis-backed concerns. When false the app runs without rate limiting,
# the idempotency Redis fast-path and background queues (idempotency still works off the table).
REDIS_ENABLED=true

# ── Rate limiting (Phase 10b) ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300              # per authenticated principal per window
RATE_LIMIT_MAX_UNAUTH=30       # per IP for unauthenticated routes (login)

# ── AI usage limits (Phase 10b — per-employee + per-policy-scope) ─────────────
AI_RATE_LIMIT_ENABLED=true
AI_MAX_RUNS_PER_EMPLOYEE_PER_DAY=200   # default when an ai_policies row sets none
AI_MAX_RUNS_PER_SCOPE_PER_DAY=1000

# ── Background queues (BullMQ; Phase 10b / 10e) ───────────────────────────────
QUEUE_WORKERS_ENABLED=true     # run workers in-process (off for web-only containers)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key                 # safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # API ONLY. Never ship to frontend.
SUPABASE_JWT_SECRET=your-jwt-secret

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
# Comma-separated allowed origins for CORS.
API_CORS_ORIGINS=http://localhost:3000
# Signing secret for HTTP-only session cookies (rotate periodically).
SESSION_COOKIE_SECRET=e4a473aa59a2cf474dc87891243656e403546f20f0228f20768b57ab6a7fa4e0
# Recent-auth window (seconds) before sensitive actions require re-auth.
RECENT_AUTH_WINDOW_SECONDS=900

# ── Authentication (Phase 10a) ────────────────────────────────────────────────
# HTTP-only session cookie. The API verifies a Supabase access token at /auth/login, maps its
# `sub` to platform_employees, enforces MFA (aal2), then issues its own session (auth_sessions).
SESSION_COOKIE_NAME=edrion_session
SESSION_TTL_SECONDS=28800            # 8h
# DEV ESCAPE HATCHES — both MUST be false in production.
#   AUTH_DEV_HEADER: honour the legacy x-employee-email header as identity (no cookie needed).
#   AUTH_DEV_LOGIN : allow POST /auth/login with { email } and no Supabase access token.
AUTH_DEV_HEADER=false
AUTH_DEV_LOGIN=false
# Account lockout: failed logins within the window before the account is locked, and for how long.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900

# ── Web (super-admin-web) ─────────────────────────────────────────────────────
# Only NEXT_PUBLIC_* are exposed to the browser. Keep secrets out of this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PORT=3000

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── AI / Copilot (Anthropic) ──────────────────────────────────────────────────
# Used only by the API. Copilot guardrails enforce confirmation before any mutation.
ANTHROPIC_API_KEY=
COPILOT_PRIMARY_MODEL=claude-opus-4-8
COPILOT_FALLBACK_MODEL=claude-sonnet-4-6

# ── Billing provider (placeholder for Phase 5) ────────────────────────────────
BILLING_PROVIDER_SECRET=
BILLING_WEBHOOK_SIGNING_SECRET=
