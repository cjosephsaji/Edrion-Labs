# ─────────────────────────────────────────────────────────────────────────────
# Edrion Super Admin Platform — environment template.
# Copy to .env and fill in. NEVER commit a real .env. The service-role key and any
# secret below must exist only in the API environment, never in the web app.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (Supabase Postgres or any Postgres 15+) ──────────────────────────
# App connection uses a LEAST-PRIVILEGE role (no UPDATE/DELETE on audit/security tables).
DATABASE_URL=postgres://macbook@localhost:5432/edrion
# Migration connection may use a higher-privilege role.
# DATABASE_MIGRATION_URL=postgres://postgres:password@localhost:5432/edrion

# ── Redis (cache, queues, rate limiting, short-lived state) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key                 # safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # API ONLY. Never ship to frontend.
SUPABASE_JWT_SECRET=local-dev-supabase-jwt-secret-please-change

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
# Comma-separated allowed origins for CORS.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# Signing secret for HTTP-only session cookies (rotate periodically).
SESSION_COOKIE_SECRET=e4a473aa59a2cf474dc87891243656e403546f20f0228f20768b57ab6a7fa4e0
# Master switch for the sensitive-action recent-auth gate. false = never prompt to re-authenticate.
RECENT_AUTH_ENABLED=false
# Recent-auth window (seconds) before sensitive actions require re-auth (only when enabled).
RECENT_AUTH_WINDOW_SECONDS=900

# ── Authentication (Phase 10a) ────────────────────────────────────────────────
SESSION_COOKIE_NAME=edrion_session
SESSION_TTL_SECONDS=28800
# DEV ONLY. Keep the legacy x-employee-email header working so the web app + old smoke run
# while the cookie flow is verified alongside. Set false in production.
AUTH_DEV_HEADER=true
# DEV ONLY. Allow POST /auth/login with { email } and no Supabase token. Set false in production.
AUTH_DEV_LOGIN=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900

# ── Institution Portal auth (Phase 12) ────────────────────────────────────────
# DEV ONLY. Honour x-institution-user-email as the portal identity (no cookie). MUST be false in prod.
PORTAL_AUTH_DEV_HEADER=false
# DEV ONLY. Let POST /v1/portal/auth/login accept { email } with no Supabase token. False in prod.
PORTAL_AUTH_DEV_LOGIN=false
# Base URL of the institution-portal web app (used to build invitation accept links).
PORTAL_WEB_URL=http://localhost:3002
# Base URL of the super-admin web app (used to build employee password-reset links).
SUPER_ADMIN_WEB_URL=http://localhost:3000
# Name of the HTTP-only portal session cookie (separate from the platform session cookie).
PORTAL_SESSION_COOKIE_NAME=edrion_portal_session
# Outbound email: leave SMTP_URL unset to use the dev log transport (invitations are logged).
# SMTP_URL=smtp://user:pass@host:587
EMAIL_FROM=Edrion <no-reply@edrion.local>

# ── Redis / rate limiting / queues (Phase 10b) ────────────────────────────────
REDIS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_MAX_UNAUTH=30
AI_RATE_LIMIT_ENABLED=true
AI_MAX_RUNS_PER_EMPLOYEE_PER_DAY=200
AI_MAX_RUNS_PER_SCOPE_PER_DAY=1000
QUEUE_WORKERS_ENABLED=true

# ── Web (super-admin-web) ─────────────────────────────────────────────────────
# Only NEXT_PUBLIC_* are exposed to the browser. Keep secrets out of this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PORT=3000

# ── Web (institution-web, port 3002) ──────────────────────────────────────────
# Dev impersonation: portal sends this as x-institution-user-email until cookie auth lands.
NEXT_PUBLIC_DEV_INSTITUTION_USER=owner@greenwood.edu

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── AI / Copilot (Anthropic) ──────────────────────────────────────────────────
# Used only by the API. Copilot guardrails enforce confirmation before any mutation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_SMALL_MODEL=gpt-5-nano-2025-08-07
OPENAI_BIG_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_RUNS_PER_STUDENT_PER_DAY=50

# ── Billing provider (placeholder for Phase 5) ────────────────────────────────
BILLING_PROVIDER_SECRET=
BILLING_WEBHOOK_SIGNING_SECRET=

# ── Message attachments (real upload; local-disk store, swap for object store later) ──
# Directory uploaded attachments are written to (relative to the API process cwd = apps/api).
ATTACHMENT_STORAGE_DIR=./var/attachments
# Max size of a single uploaded attachment, in bytes (default 25 MiB).
ATTACHMENT_MAX_BYTES=26214400

# ── Institution registration funnel ──────────────────────────────────────────
# Base URL of the public registration web app (apps/public-web) — used in registration status emails.
REGISTRATION_WEB_URL=http://localhost:3003
